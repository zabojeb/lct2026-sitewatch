APP_ENV=local
APP_NAME=sitewatch
HTTP_ADDR=0.0.0.0:8080
RUST_LOG=sitewatch_api=debug,tower_http=info

DATABASE_URL=postgres://sitewatch:sitewatch@localhost:5432/sitewatch
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central-1
S3_BUCKET=sitewatch-evidence
S3_ACCESS_KEY=sitewatch
S3_SECRET_KEY=sitewatch-local-only
S3_FORCE_PATH_STYLE=true

PUBLIC_API_BASE_URL=http://localhost:8080

# ML platform. DVC uses the AWS variables with the local MinIO endpoint in .dvc/config.
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_DISABLE_AGENT_HINT=1
SITEWATCH_CODE_REVISION=uncommitted
AWS_ACCESS_KEY_ID=sitewatch
AWS_SECRET_ACCESS_KEY=sitewatch-local-only
AWS_DEFAULT_REGION=ru-central-1

# Host ports used by Docker Compose. Override them when a local port is busy.
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITORING_PORT=8222
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8080
WEB_PORT=3000
MLOPS_POSTGRES_PORT=5433
MLFLOW_PORT=5050
DAGSTER_PORT=3001
LABEL_STUDIO_PORT=8081
LABEL_STUDIO_SECRET_KEY=sitewatch-labeling-local-only

# Live schedule service (profile: live). Generate distinct random values locally;
# do not commit the filled .env. URL-encode passwords in database URLs.
# SCHEDULE_DB_PASSWORD=
# SCHEDULE_MIGRATION_DB_PASSWORD=
# SCHEDULE_DATABASE_URL=postgres://sitewatch_schedule:<runtime-password>@postgres:5432/sitewatch_schedule
# SCHEDULE_MIGRATION_DATABASE_URL=postgres://sitewatch_schedule_migrator:<migration-password>@postgres:5432/sitewatch_schedule
# SITEWATCH_INTERNAL_TOKEN=
# SCHEDULE_PORT=8082

# Live inference sandbox (profile: live). Uses the same local token as schedule.
# Model weights are copied into ignored models/sitewatch-v1/; never commit them.
INFERENCE_DEMO_ENABLED=false
INFERENCE_DEVICE=auto
INFERENCE_PORT=8083
DEVIATIONS_PORT=8084
# Browser-facing web origin, including any custom WEB_PORT; required for production CSRF checks.
WEB_ORIGIN=http://localhost:3000
